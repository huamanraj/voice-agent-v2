# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
PUBLIC_WS_BASE_URL=ws://localhost:8080

# Provider selection: keep mock/memory for local Phase 0-2 development.
TELEPHONY_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock
LIVE_STORE_PROVIDER=memory
FINAL_STORE_PROVIDER=memory
LOGGER_PROVIDER=file

# Local agent adapter. Profiles live in config/agents.json for now and can
# later be replaced by a DB-backed adapter without changing the call pipeline.
DEFAULT_AGENT_ID=vobiz_litellm_cartesia
AGENT_CONFIG_PATH=./config/agents.json

# Vobiz outbound calling.
VOBIZ_API_BASE_URL=https://api.vobiz.ai
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=
# After ngrok: https://YOUR-NGROK-HOST/vobiz/answer
VOBIZ_ANSWER_URL=https://a8ca-2409-40e4-60-a8e2-5c4c-a4bb-c570-b424.ngrok-free.app
VOBIZ_ANSWER_METHOD=POST
VOBIZ_STREAM_WS_PATH=/ws/vobiz
VOBIZ_STREAM_AUTH_TOKEN=
VOBIZ_START_TIMEOUT_MS=3000
OUTBOUND_PROVIDER_PREWARM_ENABLED=true
OUTBOUND_PROVIDER_PREWARM_TTL_SECONDS=90
PROVIDER_HEALTH_CHECK_SECONDS=5
PROVIDER_HEALTH_TIMEOUT_MS=1000

# Provider secrets: set only when switching from mock providers.
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
HF_HUB_OFFLINE=false

# Storage
REDIS_URL=redis://localhost:6379/0
REDIS_LIVE_TTL_SECONDS=21600
POSTGRES_DSN=postgresql://user:pass@localhost:5432/voice_agent
POSTGRES_CONNECT_TIMEOUT_SECONDS=3
POSTGRES_SAVE_TIMEOUT_SECONDS=5
POSTGRES_RETRY_DIR=./logs/retry

# Concurrency
MAX_CONCURRENT_CALLS_PER_WORKER=5
QUEUE_AUDIO_IN_MAX=100
QUEUE_STT_AUDIO_MAX=150
QUEUE_VAD_AUDIO_MAX=150
QUEUE_ROLLING_AUDIO_MAX=150
QUEUE_TRANSCRIPT_EVENT_MAX=500
QUEUE_SPEECH_EVENT_MAX=500
QUEUE_TURN_EVENT_MAX=100
QUEUE_INTERRUPTION_EVENT_MAX=100
QUEUE_LLM_REQUEST_MAX=100
QUEUE_LLM_OUTPUT_MAX=500
QUEUE_TTS_REQUEST_MAX=100
QUEUE_TTS_AUDIO_MAX=200
QUEUE_TELEPHONY_AUDIO_OUT_MAX=200
QUEUE_PLAYBACK_EVENT_MAX=500
QUEUE_METRICS_MAX=1000
QUEUE_DTMF_MAX=100
QUEUE_ERROR_MAX=100
SHUTDOWN_GRACE_SECONDS=10
OUTPUT_GATE_WAIT_TIMEOUT_MS=250
PLAYBACK_COMPLETION_FALLBACK_GRACE_MS=750

# Audio
TELEPHONY_CODEC=mulaw_8k
TELEPHONY_SAMPLE_RATE=8000
OUTBOUND_CHUNK_MS=20

# Turn detection
VAD_ENABLED=true
VAD_START_MIN_MS=80
VAD_STOP_MIN_MS=350
VAD_CONFIDENCE_THRESHOLD=0.55
VAD_MODEL_PATH=./models/silero_vad.onnx
MIN_USER_SPEECH_MS=250
MIN_SILENCE_FOR_TURN_END_MS=450
MAX_SILENCE_BEFORE_FORCE_END_MS=1200
SMART_TURN_ENABLED=true
SMART_TURN_THRESHOLD=0.65
SMART_TURN_MODEL_PATH=./models/smart_turn_v3.onnx
SMART_TURN_CPU_THREADS=1
END_OF_TURN_GRACE_MS=250

# Interruption
INTERRUPTION_ENABLED=true
MIN_INTERRUPT_WORDS=3
MIN_INTERRUPTION_AUDIO_MS=180
HARD_INTERRUPT_AFTER_AUDIO_MS=350
WAIT_GATE_ON_SPEECH_START=true
CLEAR_AUDIO_ON_CONFIRMED_INTERRUPT=true
PREEMPTIVE_CLEAR_AUDIO=false
PREEMPTIVE_CLEAR_AFTER_MS=220
ALLOW_INTERRUPT_WELCOME_MESSAGE=false

# LLM
TALKER_MODEL=mock-talker
LISTENER_MODEL=mock-listener
LITELLM_API_KEY=
LITELLM_API_BASE=
LITELLM_API_VERSION=
LITELLM_LOCAL_MODEL_COST_MAP=true
LITELLM_DISABLE_HF_TOKENIZER_DOWNLOAD=true
TALKER_MAX_TOKENS=80
TALKER_TEMPERATURE=0.2
LISTENER_MAX_TOKENS=120
LISTENER_TEMPERATURE=0.0
LLM_FIRST_TOKEN_TIMEOUT_MS=3000
LLM_TOTAL_TIMEOUT_MS=15000
LLM_SENTENCE_MIN_CHARS=80
LLM_SENTENCE_MAX_CHARS=160
LLM_SENTENCE_TIMEOUT_MS=500
EMPTY_TRANSCRIPT_RETRY_ENABLED=true
EMPTY_TRANSCRIPT_RETRY_DELAY_MS=1200
EMPTY_TRANSCRIPT_MIN_AUDIO_MS=700
EMPTY_TRANSCRIPT_RETRY_TEXT=Sorry, audio clear nahi aaya. Zara repeat karenge?

# STT
DEEPGRAM_WS_URL=wss://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=100
DEEPGRAM_UTTERANCE_END_MS=1000
DEEPGRAM_KEEPALIVE_SECONDS=3
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_LANGUAGE_CODE=unknown
SARVAM_STT_SAMPLE_RATE=8000
SARVAM_STT_VAD_SIGNALS=true
SARVAM_STT_HIGH_VAD_SENSITIVITY=false
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=simran
SARVAM_TTS_TARGET_LANGUAGE_CODE=en-IN
SARVAM_TTS_SPEECH_SAMPLE_RATE=8000
SARVAM_TTS_OUTPUT_AUDIO_CODEC=linear16
SARVAM_TTS_OUTPUT_AUDIO_BITRATE=128k
SARVAM_TTS_PACE=1.0
SARVAM_TTS_TEMPERATURE=0.6
SARVAM_TTS_ENABLE_PREPROCESSING=true
SARVAM_TTS_MIN_BUFFER_SIZE=50
SARVAM_TTS_MAX_CHUNK_LENGTH=120
SARVAM_TTS_SEND_COMPLETION_EVENT=true
SARVAM_TTS_KEEPALIVE_SECONDS=20

# TTS
CARTESIA_WS_URL=wss://api.cartesia.ai/tts/websocket
CARTESIA_VERSION=2026-03-01
CARTESIA_VOICE_ID=
CARTESIA_LANGUAGE=en
CARTESIA_MODEL=sonic-3.5
CARTESIA_OUTPUT_ENCODING=pcm_mulaw
CARTESIA_SAMPLE_RATE=8000
CARTESIA_MAX_BUFFER_DELAY_MS=100
CARTESIA_ADD_TIMESTAMPS=true
TTS_FIRST_AUDIO_TIMEOUT_MS=3000

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_FULL_TRANSCRIPTS=true
MASK_PHONE_IN_SHARED_LOGS=true
CALL_LOG_QUEUE_MAX=2000
CALL_LOG_FLUSH_TIMEOUT_MS=1000

# Post-call tasks
POST_CALL_ENABLED=true
POST_CALL_TIMEOUT_SECONDS=15
POST_CALL_WEBHOOK_URL=
