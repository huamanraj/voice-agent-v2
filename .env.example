# Runtime
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
PUBLIC_WS_BASE_URL=ws://localhost:8080

# Provider selection: keep mock/memory for local Phase 0-2 development.
TELEPHONY_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock
LIVE_STORE_PROVIDER=memory
FINAL_STORE_PROVIDER=memory
LOGGER_PROVIDER=file

# Vobiz outbound calling.
VOBIZ_API_BASE_URL=https://api.vobiz.ai
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=
VOBIZ_ANSWER_URL=
VOBIZ_ANSWER_METHOD=POST
VOBIZ_STREAM_WS_PATH=/ws/vobiz

# Provider secrets: set only when switching from mock providers.
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
CARTESIA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Storage
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://user:pass@localhost:5432/voice_agent

# Concurrency
MAX_CONCURRENT_CALLS_PER_WORKER=5
QUEUE_AUDIO_IN_MAX=100
QUEUE_STT_AUDIO_MAX=150
QUEUE_VAD_AUDIO_MAX=150
QUEUE_ROLLING_AUDIO_MAX=150
QUEUE_TRANSCRIPT_EVENT_MAX=500
QUEUE_SPEECH_EVENT_MAX=500
QUEUE_TURN_EVENT_MAX=100
QUEUE_INTERRUPTION_EVENT_MAX=100
QUEUE_LLM_REQUEST_MAX=100
QUEUE_LLM_OUTPUT_MAX=500
QUEUE_TTS_REQUEST_MAX=100
QUEUE_TTS_AUDIO_MAX=200
QUEUE_TELEPHONY_AUDIO_OUT_MAX=200
QUEUE_PLAYBACK_EVENT_MAX=500
QUEUE_METRICS_MAX=1000
QUEUE_DTMF_MAX=100
QUEUE_ERROR_MAX=100
SHUTDOWN_GRACE_SECONDS=10
OUTPUT_GATE_WAIT_TIMEOUT_MS=250

# Audio
TELEPHONY_CODEC=mulaw_8k
TELEPHONY_SAMPLE_RATE=8000
OUTBOUND_CHUNK_MS=20

# Turn detection
VAD_ENABLED=true
VAD_START_MIN_MS=80
VAD_STOP_MIN_MS=350
VAD_CONFIDENCE_THRESHOLD=0.55
MIN_USER_SPEECH_MS=250
MIN_SILENCE_FOR_TURN_END_MS=450
MAX_SILENCE_BEFORE_FORCE_END_MS=1200
SMART_TURN_ENABLED=true
SMART_TURN_THRESHOLD=0.65
END_OF_TURN_GRACE_MS=250

# Interruption
INTERRUPTION_ENABLED=true
MIN_INTERRUPT_WORDS=3
MIN_INTERRUPTION_AUDIO_MS=180
HARD_INTERRUPT_AFTER_AUDIO_MS=350
WAIT_GATE_ON_SPEECH_START=true
CLEAR_AUDIO_ON_CONFIRMED_INTERRUPT=true
PREEMPTIVE_CLEAR_AUDIO=false
PREEMPTIVE_CLEAR_AFTER_MS=220
ALLOW_INTERRUPT_WELCOME_MESSAGE=false

# LLM
TALKER_MODEL=mock-talker
LISTENER_MODEL=mock-listener
LLM_FIRST_TOKEN_TIMEOUT_MS=3000
LLM_TOTAL_TIMEOUT_MS=15000

# STT
DEEPGRAM_WS_URL=wss://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=100
DEEPGRAM_UTTERANCE_END_MS=1000
DEEPGRAM_KEEPALIVE_SECONDS=3

# TTS
CARTESIA_WS_URL=wss://api.cartesia.ai/tts/websocket
CARTESIA_VERSION=2026-03-01
CARTESIA_VOICE_ID=
CARTESIA_LANGUAGE=en
CARTESIA_MODEL=sonic-3.5
CARTESIA_OUTPUT_ENCODING=pcm_mulaw
CARTESIA_SAMPLE_RATE=8000
CARTESIA_MAX_BUFFER_DELAY_MS=100
CARTESIA_ADD_TIMESTAMPS=true
TTS_FIRST_AUDIO_TIMEOUT_MS=3000

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO
LOG_FULL_TRANSCRIPTS=true
MASK_PHONE_IN_SHARED_LOGS=true
